# Sarpanch Setu - Environment Variables Blueprint
# Copy this file to .env and configure values for your deployment.

# Active Candidate identifier (corresponds to file in config/candidates/<id>.js)
# Options: candidate-kapil-mehta, candidate-001, candidate-002, default
VITE_CANDIDATE_ID=candidate-kapil-mehta

# Google Cloud Run Complaint Submission Backend API
# Enter the HTTPS trigger URL of your deployed Cloud Run service to save complaints to Google Cloud Firestore.
VITE_COMPLAINT_API_URL=https://submit-complaint-giiw7bvowq-el.a.run.app
VITE_GCP_COMPLAINT_URL=https://submit-complaint-giiw7bvowq-el.a.run.app

# Administrative Demonstration Access Key
# Sets the access PIN for the candidate campaign management and staff portal.
VITE_ADMIN_ACCESS_PIN=sarpanch789
