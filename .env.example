# Sarpanch Setu - Environment Variables Blueprint
# Copy this file to .env and configure values for your deployment.

# Active Candidate identifier (corresponds to file in config/candidates/<id>.js)
# Options: candidate-kapil-mehta, candidate-001, candidate-002, default
VITE_CANDIDATE_ID=candidate-kapil-mehta

# Supabase Backend Configuration (Optional for local testing / demo mode)
# If left blank, the application automatically runs in safe offline/local demo mode.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Administrative Demonstration Access Key
# For production, utilize Supabase Auth with Row Level Security.
# This variable sets a local demonstration access key for the Sarpanch status update portal.
VITE_ADMIN_ACCESS_PIN=sarpanch789
